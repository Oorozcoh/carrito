<!-- src/views/reset-password.handlebars -->
<style>
    .auth-container { min-height: 80vh; display: flex; justify-content: center; align-items: center; padding: 30px 20px; font-family: 'Rajdhani', sans-serif; }
    .auth-card { width: 100%; max-width: 420px; background: rgba(13, 15, 28, 0.92); border: 1px solid rgba(0, 240, 255, 0.35); border-radius: 10px; overflow: hidden; box-shadow: 0 0 40px rgba(0, 240, 255, 0.1); }
    .auth-card-head { display: flex; align-items: center; gap: 8px; padding: 12px 20px; border-bottom: 1px solid rgba(0, 240, 255, 0.2); background: rgba(0, 240, 255, 0.03); }
    .auth-dot { width: 10px; height: 10px; border-radius: 50%; }
    .auth-dot.r { background: #ff2e63; } .auth-dot.y { background: #ffcc00; } .auth-dot.g { background: #39ff14; }
    .auth-card-title { font-family: 'Orbitron', sans-serif; font-size: 0.7rem; color: #7d8598; letter-spacing: 1.5px; margin-left: 8px; }
    .auth-body { padding: 30px 28px 26px; }
    .auth-header { text-align: center; margin-bottom: 22px; }
    .auth-header h2 { margin: 0 0 6px; font-family: 'Orbitron', sans-serif; font-size: 1.3rem; color: #ffffff; letter-spacing: 1px; text-shadow: 0 0 12px rgba(0, 240, 255, 0.35); }
    .auth-header p { margin: 0; color: #7d8598; font-size: 0.88rem; }
    .form-group { margin-bottom: 18px; display: flex; flex-direction: column; }
    .form-group label { font-family: 'Orbitron', sans-serif; font-weight: 600; margin-bottom: 8px; color: #00f0ff; font-size: 0.7rem; letter-spacing: 1px; text-transform: uppercase; }
    .form-group input { padding: 12px 14px; border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 6px; background: rgba(255, 255, 255, 0.03); color: #f1f5f9; font-family: 'Rajdhani', sans-serif; font-size: 0.98rem; outline: none; transition: border-color 0.2s, box-shadow 0.2s, background 0.2s; }
    .form-group input::placeholder { color: #4b5568; }
    .form-group input:focus { border-color: #00f0ff; background: rgba(0, 240, 255, 0.05); box-shadow: 0 0 0 3px rgba(0, 240, 255, 0.15); }
    .btn-submit { width: 100%; padding: 13px; background: transparent; border: 1px solid #00f0ff; color: #00f0ff; font-family: 'Orbitron', sans-serif; font-weight: 600; font-size: 0.85rem; letter-spacing: 1px; text-transform: uppercase; border-radius: 6px; cursor: pointer; transition: all 0.2s ease; margin-top: 6px; }
    .btn-submit:hover { background: rgba(0, 240, 255, 0.12); box-shadow: 0 0 18px rgba(0, 240, 255, 0.35); }
    .btn-submit:disabled { border-color: #4b5568; color: #4b5568; cursor: not-allowed; box-shadow: none; }
    .alert-box { margin-top: 18px; padding: 12px; border-radius: 6px; font-size: 0.88rem; text-align: center; font-family: 'Rajdhani', sans-serif; display: none; }
    .alert-success { background: rgba(57, 255, 20, 0.08); color: #39ff14; border: 1px solid rgba(57, 255, 20, 0.4); }
    .alert-error { background: rgba(255, 46, 99, 0.08); color: #ff5c7f; border: 1px solid rgba(255, 46, 99, 0.4); }
    .auth-footer { margin-top: 22px; text-align: center; font-size: 0.88rem; color: #7d8598; }
    .auth-footer a { color: #ff2e97; text-decoration: none; font-weight: 600; }
    .auth-footer a:hover { text-shadow: 0 0 8px rgba(255, 46, 151, 0.6); }
</style>

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-card-head">
            <span class="auth-dot r"></span><span class="auth-dot y"></span><span class="auth-dot g"></span>
            <span class="auth-card-title">2OH-STORE // AUTH-CONSOLE</span>
        </div>

        <div class="auth-body">
            {{#if token}}
                <div class="auth-header">
                    <h2>Nueva Contraseña</h2>
                    <p>Elegí tu nueva contraseña. No puede ser igual a la anterior.</p>
                </div>

                <form id="resetForm">
                    <input type="hidden" id="token" value="{{token}}">

                    <div class="form-group">
                        <label for="newPassword">Nueva Contraseña</label>
                        <input type="password" id="newPassword" name="newPassword" placeholder="••••••••" required minlength="6">
                    </div>

                    <div class="form-group">
                        <label for="confirmPassword">Confirmar Contraseña</label>
                        <input type="password" id="confirmPassword" name="confirmPassword" placeholder="••••••••" required minlength="6">
                    </div>

                    <button type="submit" id="btnSubmit" class="btn-submit">
                        Restablecer Contraseña
                    </button>
                </form>

                <div id="alertBox" class="alert-box"></div>
            {{else}}
                <div class="auth-header">
                    <h2>Enlace inválido</h2>
                    <p>Este enlace de recuperación no incluye un token válido. Solicitá uno nuevo desde la pantalla de recuperación de contraseña.</p>
                </div>
            {{/if}}

            <div class="auth-footer">
                <a href="/login">← Volver a iniciar sesión</a>
            </div>
        </div>
    </div>
</div>

{{#if token}}
<script>
    const resetForm = document.getElementById('resetForm');
    const btnSubmit = document.getElementById('btnSubmit');
    const alertBox = document.getElementById('alertBox');

    function showAlert(message, type) {
        alertBox.className = `alert-box alert-${type}`;
        alertBox.innerText = message;
        alertBox.style.display = 'block';
    }

    resetForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        alertBox.style.display = 'none';

        const token = document.getElementById('token').value;
        const newPassword = document.getElementById('newPassword').value;
        const confirmPassword = document.getElementById('confirmPassword').value;

        if (newPassword !== confirmPassword) {
            showAlert('Las contraseñas no coinciden.', 'error');
            return;
        }

        btnSubmit.disabled = true;
        btnSubmit.innerText = 'Guardando...';

        try {
            const response = await fetch('/api/sessions/reset-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ token, newPassword })
            });

            const result = await response.json();

            if (response.ok) {
                showAlert(result.message, 'success');
                setTimeout(() => { window.location.href = '/login'; }, 1800);
            } else {
                showAlert(result.message || 'No se pudo restablecer la contraseña.', 'error');
                btnSubmit.disabled = false;
                btnSubmit.innerText = 'Restablecer Contraseña';
            }
        } catch (error) {
            console.error('Error de red:', error);
            showAlert('Ocurrió un error al conectar con el servidor.', 'error');
            btnSubmit.disabled = false;
            btnSubmit.innerText = 'Restablecer Contraseña';
        }
    });
</script>
{{/if}}
