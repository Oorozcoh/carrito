<!-- src/views/profile.handlebars -->
<div style="max-width: 480px; margin: 60px auto; background: #0b0b16; border: 1px solid #00ffff; border-radius: 10px; padding: 30px; font-family: monospace; color: #fff;">
    <h2 style="color: #00ffff; text-shadow: 0 0 8px #00ffff;">👤 Mi Perfil</h2>
    <p><strong>Nombre:</strong> {{user.first_name}} {{user.last_name}}</p>
    <p><strong>Email:</strong> {{user.email}}</p>
    <p><strong>Edad:</strong> {{user.age}}</p>
    <p><strong>Rol:</strong> {{user.role}}</p>

    {{#if user.cart}}
        <a href="/carts/{{user.cart}}" style="display: inline-block; margin-top: 15px; color: #39ff14; text-decoration: none; border: 1px solid #39ff14; padding: 8px 14px; border-radius: 4px;">
            🛒 Ir a mi carrito
        </a>
    {{/if}}

    <a href="/api/sessions/logout" style="display: inline-block; margin-top: 15px; margin-left: 10px; color: #ff4d4d; text-decoration: none; border: 1px solid #ff4d4d; padding: 8px 14px; border-radius: 4px;">
        Cerrar Sesión 🚪
    </a>
</div>
