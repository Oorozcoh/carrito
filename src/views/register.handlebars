<!-- src/views/register.handlebars -->
<style>
    .auth-container {
        min-height: 85vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 30px 20px;
        font-family: 'Rajdhani', sans-serif;
    }

    .auth-card {
        width: 100%;
        max-width: 500px;
        background: rgba(13, 15, 28, 0.92);
        border: 1px solid rgba(57, 255, 20, 0.3);
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 0 40px rgba(57, 255, 20, 0.08);
    }

    .auth-card-head {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 20px;
        border-bottom: 1px solid rgba(57, 255, 20, 0.2);
        background: rgba(57, 255, 20, 0.03);
    }

    .auth-dot { width: 10px; height: 10px; border-radius: 50%; }
    .auth-dot.r { background: #ff2e63; }
    .auth-dot.y { background: #ffcc00; }
    .auth-dot.g { background: #39ff14; }

    .auth-card-title {
        font-family: 'Orbitron', sans-serif;
        font-size: 0.7rem;
        color: #7d8598;
        letter-spacing: 1.5px;
        margin-left: 8px;
    }

    .auth-body { padding: 30px 28px 26px; }

    .auth-header { text-align: center; margin-bottom: 24px; }

    .auth-header h2 {
        margin: 0 0 6px;
        font-family: 'Orbitron', sans-serif;
        font-size: 1.4rem;
        color: #ffffff;
        letter-spacing: 1px;
        text-shadow: 0 0 12px rgba(57, 255, 20, 0.3);
    }

    .auth-header p { margin: 0; color: #7d8598; font-size: 0.9rem; }

    .form-row { display: flex; gap: 14px; }

    .form-group { margin-bottom: 16px; display: flex; flex-direction: column; flex: 1; }

    .form-group label {
        font-family: 'Orbitron', sans-serif;
        font-weight: 600;
        margin-bottom: 7px;
        color: #39ff14;
        font-size: 0.68rem;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .form-group input {
        padding: 11px 13px;
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 6px;
        background: rgba(255, 255, 255, 0.03);
        color: #f1f5f9;
        font-family: 'Rajdhani', sans-serif;
        font-size: 0.95rem;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
    }

    .form-group input::placeholder { color: #4b5568; }

    .form-group input:focus {
        border-color: #39ff14;
        background: rgba(57, 255, 20, 0.05);
        box-shadow: 0 0 0 3px rgba(57, 255, 20, 0.15);
    }

    .btn-submit {
        width: 100%;
        padding: 13px;
        background: transparent;
        border: 1px solid #39ff14;
        color: #39ff14;
        font-family: 'Orbitron', sans-serif;
        font-weight: 600;
        font-size: 0.85rem;
        letter-spacing: 1px;
        text-transform: uppercase;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s ease;
        margin-top: 8px;
    }

    .btn-submit:hover {
        background: rgba(57, 255, 20, 0.12);
        box-shadow: 0 0 18px rgba(57, 255, 20, 0.35);
    }

    .btn-submit:disabled {
        border-color: #4b5568;
        color: #4b5568;
        cursor: not-allowed;
        box-shadow: none;
    }

    .alert-box {
        margin-top: 18px;
        padding: 12px;
        border-radius: 6px;
        font-size: 0.88rem;
        text-align: center;
        font-family: 'Rajdhani', sans-serif;
        display: none;
    }

    .alert-success {
        background: rgba(57, 255, 20, 0.08);
        color: #39ff14;
        border: 1px solid rgba(57, 255, 20, 0.4);
    }

    .alert-error {
        background: rgba(255, 46, 99, 0.08);
        color: #ff5c7f;
        border: 1px solid rgba(255, 46, 99, 0.4);
    }

    .auth-footer {
        margin-top: 20px;
        text-align: center;
        font-size: 0.88rem;
        color: #7d8598;
    }

    .auth-footer a {
        color: #00f0ff;
        text-decoration: none;
        font-weight: 600;
    }

    .auth-footer a:hover { text-shadow: 0 0 8px rgba(0, 240, 255, 0.6); }

    @media (max-width: 480px) {
        .form-row { flex-direction: column; gap: 0; }
    }
</style>

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-card-head">
            <span class="auth-dot r"></span><span class="auth-dot y"></span><span class="auth-dot g"></span>
            <span class="auth-card-title">2OH-STORE // AUTH-CONSOLE</span>
        </div>

        <div class="auth-body">
            <div class="auth-header">
                <h2>Crear Cuenta</h2>
                <p>Ingresa tus datos para registrarte en el sistema</p>
            </div>

            <form id="registerForm">
                <!-- Fila doble: Nombre y Apellido -->
                <div class="form-row">
                    <div class="form-group">
                        <label for="first_name">Nombre</label>
                        <input type="text" id="first_name" name="first_name" placeholder="Ej. Juan" required>
                    </div>

                    <div class="form-group">
                        <label for="last_name">Apellido</label>
                        <input type="text" id="last_name" name="last_name" placeholder="Ej. Pérez" required>
                    </div>
                </div>

                <div class="form-group">
                    <label for="email">Correo Electrónico</label>
                    <input type="email" id="email" name="email" placeholder="ejemplo@correo.com" required>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="age">Edad</label>
                        <input type="number" id="age" name="age" min="1" max="120" placeholder="25" required>
                    </div>

                    <div class="form-group">
                        <label for="password">Contraseña</label>
                        <input type="password" id="password" name="password" placeholder="••••••••" required>
                    </div>
                </div>

                <button type="submit" id="btnSubmit" class="btn-submit">
                    Registrarse
                </button>
            </form>

            <div id="alertBox" class="alert-box"></div>

            <div class="auth-footer">
                ¿Ya tienes una cuenta? <a href="/login">Inicia sesión aquí</a>
            </div>
        </div>
    </div>
</div>

<script>
    // Referencias a los elementos del DOM
    const registerForm = document.getElementById('registerForm');
    const btnSubmit = document.getElementById('btnSubmit');
    const alertBox = document.getElementById('alertBox');

    // Función auxiliar para mostrar alertas en pantalla
    function showAlert(message, type) {
        alertBox.className = `alert-box alert-${type}`;
        alertBox.innerText = message;
        alertBox.style.display = 'block';
    }

    // Listener para procesar el envío del formulario
    registerForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Limpiar alertas anteriores y bloquear el botón durante el envío
        alertBox.style.display = 'none';
        btnSubmit.disabled = true;
        btnSubmit.innerText = 'Registrando...';

        // Captura de datos del formulario en un objeto JavaScript
        const formData = new FormData(registerForm);
        const userData = {};
        formData.forEach((value, key) => {
            userData[key] = value;
        });

        try {
            // Petición HTTP asíncrona a la API de registro
            const response = await fetch('/api/sessions/register', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(userData)
            });

            const result = await response.json();

            if (response.ok) {
                showAlert('¡Registro exitoso! Redirigiendo al inicio de sesión...', 'success');
                registerForm.reset();

                // Redirección al login tras 1.5 segundos
                setTimeout(() => {
                    window.location.href = '/login';
                }, 1500);
            } else {
                showAlert(result.error || result.message || 'Error al completar el registro.', 'error');
                btnSubmit.disabled = false;
                btnSubmit.innerText = 'Registrarse';
            }
        } catch (error) {
            console.error('Error de red:', error);
            showAlert('Ocurrió un error al conectar con el servidor.', 'error');
            btnSubmit.disabled = false;
            btnSubmit.innerText = 'Registrarse';
        }
    });
</script>
