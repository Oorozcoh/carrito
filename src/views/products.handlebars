<!-- src/views/products.handlebars -->
<div style="max-width: 1200px; margin: 0 auto; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; padding: 20px;">
    <h1 style="color: #00ffff; text-shadow: 0 0 10px #00ffff; text-align: center; font-family: monospace;">2OH CATÁLOGO</h1>
    <p style="color: #ff00ff; text-align: center; margin-bottom: 30px;">Explora nuestros componentes disponibles</p>

    <!-- Grilla de Tarjetas de Productos -->
    <div style="display: flex; flex-wrap: wrap; gap: 25px; justify-content: center;">
        {{#each products}}
        <div style="background-color: #0b0b16; border: 2px solid #ff00ff; border-radius: 12px; width: 280px; padding: 20px; box-shadow: 0 0 15px rgba(255, 0, 255, 0.3); color: #fff; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
                <h3 style="color: #00ffff; margin-top: 0; font-family: monospace; font-size: 18px;">{{this.title}}</h3>
                <p style="font-size: 14px; color: #ccc; min-height: 45px; line-height: 1.4;">{{this.description}}</p>
                <p style="font-size: 13px; color: #888; margin: 5px 0;">Categoría: <span style="color: #ff00ff;">{{this.category}}</span></p>
                <p style="font-size: 22px; color: #39ff14; font-weight: bold; margin: 15px 0 0 0; text-shadow: 0 0 5px rgba(57, 255, 20, 0.5);">${{this.price}}</p>
            </div>
            
            <button class="btn-add-cart" data-id="{{this._id}}" style="background-color: #39ff14; color: #000; font-weight: bold; padding: 10px 18px; border: none; border-radius: 6px; cursor: pointer; transition: opacity 0.2s; margin-top: 15px;">
                AGREGAR AL CARRITO 🛒
            </button>
        </div>
        {{/each}}
    </div>

    <!-- Paginación Visual -->
    <div style="display: flex; justify-content: center; align-items: center; gap: 20px; margin-top: 50px;">
        {{#if hasPrevPage}}
            <a href="/products?page={{prevPage}}" style="background-color: #00ffff; color: #000; text-decoration: none; padding: 10px 18px; border-radius: 6px; font-weight: bold; box-shadow: 0 0 10px #00ffff; font-family: monospace;">« PREV</a>
        {{/if}}

        <span style="color: #fff; font-size: 16px; font-family: monospace;">
            PÁGINA {{page}} DE {{totalPages}}
        </span>

        {{#if hasNextPage}}
            <a href="/products?page={{nextPage}}" style="background-color: #00ffff; color: #000; text-decoration: none; padding: 10px 18px; border-radius: 6px; font-weight: bold; box-shadow: 0 0 10px #00ffff; font-family: monospace;">NEXT »</a>
        {{/if}}
    </div>
</div>

<script>
    // Obtenemos el ID del carrito dinámicamente desde el objeto de sesión enviado por Handlebars
    // Si la sesión no tiene carrito, se usa una cadena vacía
    const USER_CART_ID = "{{user.cart}}";

    document.addEventListener('click', async (event) => {
        if (event.target && event.target.classList.contains('btn-add-cart')) {
            const button = event.target;
            const productId = button.getAttribute('data-id');
            const originalText = button.innerText;

            // Validar que exista un ID de carrito antes de realizar la petición
            if (!USER_CART_ID) {
                alert('⚠️ No se detectó un carrito asociado a tu usuario. Inicia sesión nuevamente.');
                return;
            }

            button.disabled = true;
            button.innerText = 'AGREGANDO... ⏳';
            button.style.opacity = '0.7';

            try {
                // Realizamos el fetch utilizando el ID dinámico del usuario
                const response = await fetch(`/api/carts/${USER_CART_ID}/products/${productId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });

                const data = await response.json();

                if (response.ok && (data.status === 'success' || response.status === 200)) {
                    alert('⚡ Producto añadido exitosamente al carrito.');
                } else {
                    alert('⚠️ ' + (data.message || data.error || 'No se pudo agregar el producto.'));
                }
            } catch (error) {
                console.error('Error de red:', error);
                alert('❌ Ocurrió un error al conectar con el servidor.');
            } finally {
                button.disabled = false;
                button.innerText = originalText;
                button.style.opacity = '1';
            }
        }
    });
</script>