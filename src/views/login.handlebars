<!-- src/views/login.handlebars -->
<style>
    .auth-container {
        min-height: 80vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 30px 20px;
        font-family: 'Rajdhani', sans-serif;
    }

    .auth-card {
        width: 100%;
        max-width: 420px;
        background: rgba(13, 15, 28, 0.92);
        border: 1px solid rgba(0, 240, 255, 0.35);
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 0 40px rgba(0, 240, 255, 0.1);
    }

    .auth-card-head {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 20px;
        border-bottom: 1px solid rgba(0, 240, 255, 0.2);
        background: rgba(0, 240, 255, 0.03);
    }

    .auth-dot { width: 10px; height: 10px; border-radius: 50%; }
    .auth-dot.r { background: #ff2e63; }
    .auth-dot.y { background: #ffcc00; }
    .auth-dot.g { background: #39ff14; }

    .auth-card-title {
        font-family: 'Orbitron', sans-serif;
        font-size: 0.7rem;
        color: #7d8598;
        letter-spacing: 1.5px;
        margin-left: 8px;
    }

    .auth-body { padding: 30px 28px 26px; }

    .auth-header { text-align: center; margin-bottom: 26px; }

    .auth-header h2 {
        margin: 0 0 6px;
        font-family: 'Orbitron', sans-serif;
        font-size: 1.4rem;
        color: #ffffff;
        letter-spacing: 1px;
        text-shadow: 0 0 12px rgba(0, 240, 255, 0.35);
    }

    .auth-header p { margin: 0; color: #7d8598; font-size: 0.9rem; }

    .form-group { margin-bottom: 18px; display: flex; flex-direction: column; }

    .form-group label {
        font-family: 'Orbitron', sans-serif;
        font-weight: 600;
        margin-bottom: 8px;
        color: #00f0ff;
        font-size: 0.7rem;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .form-group input {
        padding: 12px 14px;
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 6px;
        background: rgba(255, 255, 255, 0.03);
        color: #f1f5f9;
        font-family: 'Rajdhani', sans-serif;
        font-size: 0.98rem;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
    }

    .form-group input::placeholder { color: #4b5568; }

    .form-group input:focus {
        border-color: #00f0ff;
        background: rgba(0, 240, 255, 0.05);
        box-shadow: 0 0 0 3px rgba(0, 240, 255, 0.15);
    }

    .btn-submit {
        width: 100%;
        padding: 13px;
        background: transparent;
        border: 1px solid #00f0ff;
        color: #00f0ff;
        font-family: 'Orbitron', sans-serif;
        font-weight: 600;
        font-size: 0.85rem;
        letter-spacing: 1px;
        text-transform: uppercase;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s ease;
        margin-top: 6px;
    }

    .btn-submit:hover {
        background: rgba(0, 240, 255, 0.12);
        box-shadow: 0 0 18px rgba(0, 240, 255, 0.35);
    }

    .btn-submit:disabled {
        border-color: #4b5568;
        color: #4b5568;
        cursor: not-allowed;
        box-shadow: none;
    }

    .alert-box {
        margin-top: 18px;
        padding: 12px;
        border-radius: 6px;
        font-size: 0.88rem;
        text-align: center;
        font-family: 'Rajdhani', sans-serif;
        display: none;
    }

    .alert-success {
        background: rgba(57, 255, 20, 0.08);
        color: #39ff14;
        border: 1px solid rgba(57, 255, 20, 0.4);
    }

    .alert-error {
        background: rgba(255, 46, 99, 0.08);
        color: #ff5c7f;
        border: 1px solid rgba(255, 46, 99, 0.4);
    }

    .auth-footer {
        margin-top: 22px;
        text-align: center;
        font-size: 0.88rem;
        color: #7d8598;
    }

    .auth-footer a {
        color: #ff2e97;
        text-decoration: none;
        font-weight: 600;
    }

    .auth-footer a:hover { text-shadow: 0 0 8px rgba(255, 46, 151, 0.6); }

    .oauth-divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 20px 0;
        color: #4b5568;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
    .oauth-divider::before, .oauth-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: rgba(255, 255, 255, 0.1);
    }

    .oauth-buttons { display: flex; flex-direction: column; gap: 10px; }

    .btn-oauth {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 11px;
        border-radius: 6px;
        border: 1px solid rgba(255, 255, 255, 0.15);
        background: rgba(255, 255, 255, 0.03);
        color: #f1f5f9;
        text-decoration: none;
        font-family: 'Rajdhani', sans-serif;
        font-size: 0.9rem;
        font-weight: 600;
        transition: all 0.2s ease;
    }
    .btn-oauth:hover { background: rgba(255, 255, 255, 0.08); }
    .btn-oauth.github:hover { border-color: #f1f5f9; }
    .btn-oauth.google:hover { border-color: #ff5c5c; }
    .btn-oauth.microsoft:hover { border-color: #00a4ef; }
    .btn-oauth svg { width: 18px; height: 18px; flex-shrink: 0; }
</style>

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-card-head">
            <span class="auth-dot r"></span><span class="auth-dot y"></span><span class="auth-dot g"></span>
            <span class="auth-card-title">2OH-STORE // AUTH-CONSOLE</span>
        </div>

        <div class="auth-body">
            <div class="auth-header">
                <h2>Iniciar Sesión</h2>
                <p>Ingresa tus credenciales para acceder</p>
            </div>

            <form id="loginForm">
                <div class="form-group">
                    <label for="email">Correo Electrónico</label>
                    <input type="email" id="email" name="email" placeholder="ejemplo@correo.com" required>
                </div>

                <div class="form-group">
                    <label for="password">Contraseña</label>
                    <input type="password" id="password" name="password" placeholder="••••••••" required>
                </div>

                <button type="submit" id="btnSubmit" class="btn-submit">
                    Ingresar
                </button>
            </form>

            <div style="text-align: center; margin-top: 14px;">
                <a href="/forgot-password" style="color: #7d8598; text-decoration: none; font-size: 0.85rem;">¿Olvidaste tu contraseña?</a>
            </div>

            {{#if hasOAuth}}
                <div class="oauth-divider">o continuá con</div>
                <div class="oauth-buttons">
                    {{#if oauthProviders.github}}
                        <a href="/api/sessions/github" class="btn-oauth github">
                            <svg viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
                            GitHub
                        </a>
                    {{/if}}
                    {{#if oauthProviders.google}}
                        <a href="/api/sessions/google" class="btn-oauth google">
                            <svg viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg"><path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z"/><path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z"/><path fill="#FBBC05" d="M3.964 10.71A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.042l3.007-2.332z"/><path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z"/></svg>
                            Google
                        </a>
                    {{/if}}
                    {{#if oauthProviders.microsoft}}
                        <a href="/api/sessions/microsoft" class="btn-oauth microsoft">
                            <svg viewBox="0 0 21 21" xmlns="http://www.w3.org/2000/svg"><rect x="1" y="1" width="9" height="9" fill="#F25022"/><rect x="11" y="1" width="9" height="9" fill="#7FBA00"/><rect x="1" y="11" width="9" height="9" fill="#00A4EF"/><rect x="11" y="11" width="9" height="9" fill="#FFB900"/></svg>
                            Microsoft
                        </a>
                    {{/if}}
                </div>
            {{/if}}

            <div id="alertBox" class="alert-box"></div>

            <div class="auth-footer">
                ¿No tienes una cuenta? <a href="/register">Regístrate aquí</a>
            </div>
        </div>
    </div>
</div>

<script>
    // Referencias a los elementos del DOM
    const loginForm = document.getElementById('loginForm');
    const btnSubmit = document.getElementById('btnSubmit');
    const alertBox = document.getElementById('alertBox');

    // Función auxiliar para mostrar alertas de feedback visual
    function showAlert(message, type) {
        alertBox.className = `alert-box alert-${type}`;
        alertBox.innerText = message;
        alertBox.style.display = 'block';
    }

    // Listener para el evento submit del formulario
    loginForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Limpiar alertas previas y activar estado de carga
        alertBox.style.display = 'none';
        btnSubmit.disabled = true;
        btnSubmit.innerText = 'Cargando...';

        // Captura de datos
        const formData = new FormData(loginForm);
        const credentials = {};
        formData.forEach((value, key) => {
            credentials[key] = value;
        });

        try {
            // Petición a la API de sesiones para autenticación
            const response = await fetch('/api/sessions/login', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(credentials)
            });

            const result = await response.json();

            if (response.ok) {
                showAlert('¡Inicio de sesión exitoso! Redirigiendo...', 'success');
                // Redirección al catálogo principal de productos tras la autenticación
                setTimeout(() => {
                    window.location.href = '/products';
                }, 1500);
            } else {
                showAlert(result.error || result.message || 'Credenciales incorrectas.', 'error');
                btnSubmit.disabled = false;
                btnSubmit.innerText = 'Ingresar';
            }
        } catch (error) {
            console.error('Error de comunicación:', error);
            showAlert('Ocurrió un error al conectar con el servidor.', 'error');
            btnSubmit.disabled = false;
            btnSubmit.innerText = 'Ingresar';
        }
    });
</script>
