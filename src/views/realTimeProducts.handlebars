<div class="cyber-container">
    <h2 class="cyber-title">⚡ Productos en Tiempo Real (WebSockets)</h2>

    <!-- Contenedor dinámico donde se renderizarán los productos vía Socket.io -->
    <div id="products-list" class="cyber-cart-list">
        {{#each products}}
            <div class="cyber-card" id="product-{{this._id}}">
                <div class="cyber-card-body">
                    <h3 class="product-title">{{this.title}}</h3>
                    <p class="product-detail">Categoría: <span class="neon-text-cyan">{{this.category}}</span></p>
                    <p class="product-detail">Precio: <span class="neon-text-green">${{this.price}}</span></p>
                    <p class="product-detail">Stock: <span class="neon-text-pink">{{this.stock}}</span></p>
                </div>
                <div class="cyber-card-actions">
                    <button class="cyber-btn cyber-btn-danger btn-delete" onclick="deleteProduct('{{this._id}}')">
                        🗑️ ELIMINAR
                    </button>
                </div>
            </div>
        {{/each}}
    </div>
</div>

<!-- Cliente de Socket.io y script de control -->
<script src="/socket.io/socket.io.js"></script>
<script src="/js/realtime.js"></script>