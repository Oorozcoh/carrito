PORT=8080
MONGO_URI=mongodb+srv://<usuario>:<password>@cluster-backend-db.kc7apkb.mongodb.net/carritoDB?retryWrites=true&w=majority
JWT_SECRET=reemplaza-esto-por-una-cadena-larga-y-aleatoria
SESSION_SECRET=otra-cadena-larga-y-aleatoria-distinta-de-jwt-secret

# --- Mailing (recuperación de contraseña) ---
# MAIL_SERVICE: cualquier servicio soportado por Nodemailer (por defecto "gmail").
# Si usás Gmail, MAIL_PASS NO es tu contraseña normal: es una "contraseña de
# aplicación" que generás en https://myaccount.google.com/apppasswords
# (requiere tener la verificación en 2 pasos activada en esa cuenta).
MAIL_SERVICE=gmail
MAIL_USER=tu-correo@gmail.com
MAIL_PASS=tu-contraseña-de-aplicacion-de-16-caracteres

# --- Login social (opcional: cada proveedor solo se activa si están
# sus 2-3 variables completas; si faltan, esa opción simplemente no
# aparece y el resto de la app sigue funcionando normal) ---

# GitHub: registrar la app en https://github.com/settings/developers
# "Authorization callback URL" debe ser EXACTAMENTE igual a GITHUB_CALLBACK_URL
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8080/api/sessions/github/callback

# Google: registrar en https://console.cloud.google.com/apis/credentials
# "Authorized redirect URIs" debe ser EXACTAMENTE igual a GOOGLE_CALLBACK_URL
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/sessions/google/callback

# Microsoft: registrar en https://portal.azure.com (Azure Active Directory > App registrations)
# "Redirect URI" debe ser EXACTAMENTE igual a MICROSOFT_CALLBACK_URL
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:8080/api/sessions/microsoft/callback
# Qué cuentas de Microsoft acepta:
#   common        = personales Y educativas/laborales mezcladas (default si se omite)
#   organizations = SOLO educativas/laborales, de cualquier institución
#   consumers     = SOLO personales (outlook.com, hotmail, live.com)
#   <tenant-id>   = SOLO la institución con ese "Directory (tenant) ID" específico
#                   (lo encontrás en Azure -> tu app -> Overview, una vez que la
#                   registraste como "Single tenant" dentro del tenant de tu institución)
MICROSOFT_TENANT=common
